{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-russia-vector",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/o/*"]
  },
  "r2_buckets": [{ "binding": "ORIGINALS", "bucket_name": "atlas-russia-originals" }],
  "routes": [{ "pattern": "atlas.ebpm.center", "custom_domain": true }],
  "observability": { "enabled": true }
}
